[Unit]
Description=dispatcher in-TEE attestation agent (Azure SEV-SNP + vTPM, direct)
Documentation=https://github.com/d0cd/dispatcher/blob/main/docs/confidential-azure-uki.md
# The agent serves the sealed exchange over TCP and needs the vTPM to produce the
# AK-signed PCR11 quote; bring it up once the network and TPM are ready.
After=network-online.target dev-tpmrm0.device
Wants=network-online.target

[Service]
Type=simple
# Needs the vTPM (/dev/tpmrm0) for the SNP+vTPM quote; runs as root by default.
ExecStart=/usr/local/bin/dispatcher-attest-azuresnp --addr=:8443
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target

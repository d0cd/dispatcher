# Binary (root only, not cmd/dispatcher/ directory)
/dispatcher
/dispatch
/dispatcher-bin
/dispatcher-*
kubectl

# Test and build artifacts
tmp/
*.test
coverage.out

# Runtime state (created by `dispatcher run`)
runs/


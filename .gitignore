.env
.env.local

# Local-only editor/agent config
.claude/settings.local.json

# IDE
.vscode/
.idea/

# OS
.DS_Store

# Working notes / feedback drafts
/feedback.md

# Captured TEE attestation fixtures (per-capture, bulky; not committed)
/experiments/confidential-attestation/fixtures/*
!/experiments/confidential-attestation/fixtures/.gitkeep

# Confidential Space agent build artifacts (compiled binary + Dockerfile)
/experiments/confidential-attestation/agent/
